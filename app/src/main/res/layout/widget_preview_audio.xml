<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/WidgetPreviewRoot"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView style="@style/WidgetPreviewTitle" android:text="Resume" />

        <TextView
            style="@style/WidgetPreviewHeadline"
            android:layout_marginTop="4dp"
            android:text="Ar-Rahman"
            android:textSize="16sp" />

        <TextView style="@style/WidgetPreviewMuted" android:text="Alafasy · 3:12" android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_preview_pill"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Play"
        android:textColor="#1A1408"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
