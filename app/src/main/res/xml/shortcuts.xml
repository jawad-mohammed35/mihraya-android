<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_quran"
        android:shortcutId="quran"
        android:shortcutLongLabel="@string/shortcut_quran"
        android:shortcutShortLabel="@string/shortcut_quran">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.mihraya.app.ShortcutActivity"
            android:targetPackage="com.mihraya.app">
