<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetPreviewRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/widget_preview_background</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="WidgetPreviewTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#DCC394</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetPreviewRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetPreviewName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#F3F1EC</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetPreviewTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#B7B3AA</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetPreviewHeadline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#F3F1EC</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetPreviewMuted">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#B7B3AA</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="WidgetPreviewAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#DCC394</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
